# .clangd — clangd Language Server Configuration for GPU SpMV
# Works with: VSCode (clangd extension), neovim (nvim-lspconfig), GitHub Copilot CLI
# Requires: compile_commands.json (generated by CMake with -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)

CompileFlags:
  # CUDA files: treat as CUDA C++ to suppress false positives
  Add:
    - --cuda-gpu-arch=sm_80
    - -std=c++17
    - -x
    - cuda
  # Remove flags clangd doesn't understand from nvcc
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - -Xcudafe*
    - --expt-relaxed-constexpr
    - --expt-extended-lambda
    - -gencode*
    - -arch*
    - -code*

Diagnostics:
  # Suppress CUDA-specific false positives
  Suppress:
    - drv_unsupported_opt_for_target
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - modernize-use-override
      - modernize-use-nullptr
      - modernize-use-default-member-init
      - readability-identifier-naming
      - performance-unnecessary-copy-initialization
    Remove:
      - fuchsia-*
      - google-*
      - zircon-*
      - abseil-*
      - llvmlibc-*

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true

Index:
  Background: Build

---
# For .cu and .cuh files only: enable CUDA host+device compilation
If:
  PathMatch: [.*\.cu, .*\.cuh]
CompileFlags:
  Add:
    - --cuda-host-only
